# ==============================================================================
# CareerOS v3 — Frontend Environment Variables (.env.example)
# ==============================================================================

# Supabase URL for public client authentication and tables
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Public Anonymous Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# API Base URL: Base URL for backend server endpoints
# Use http://localhost:8000 for local dev or your production domain (e.g., https://api.careeros.zopday.app)
VITE_API_BASE=http://localhost:8000

# Google Gemini API Key: Required for front-end RAG/audio connections
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_API_KEY_voice=your-gemini-api-key-here

# Gemini Live Voice model path
VITE_GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
