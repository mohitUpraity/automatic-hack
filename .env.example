# ==============================================================================
# CareerOS v3 — Unified Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local execution, or paste into Cloud IDP (ZopDay/Railway/Render)
# Do NOT commit your real .env file with actual API secrets to Git!
# ==============================================================================

# ── Core Runtime & Security Settings ──────────────────────────────────────────
ARMORIQ_SHIELD_DEFAULT=ON
PYTHONUNBUFFERED=1
PORT=8000
NODE_ENV=production
JWT_SECRET=careeros_super_secret_jwt_key_2026

# ── Multi-Agent LLM & Intelligence Engines ────────────────────────────────────
# Groq API Key: Used for ultra-fast multi-agent orchestration and tool routing
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key: Used for Gemini Live 2-Way AI Interview & 768d Vector Embeddings
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ── Web Scraping & Company Intel ─────────────────────────────────────────────
# Firecrawl API Key: Used for web scouting, job scraping, and company research
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# ── Cloud Persistent Storage (Supabase PostgreSQL) ────────────────────────────
# Supabase URL & Service Role Key for Vector DB, Users, and Interview Transcripts
SUPABASE_URL=https://wjrjpvrgmtbjpwzmmval.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
